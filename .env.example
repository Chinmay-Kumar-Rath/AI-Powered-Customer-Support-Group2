# Copy this file to .env and replace the placeholders with real credentials.
# Never commit .env or real API keys.

GEMINI_API_KEY=your-gemini-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=customer-support-kb-rag-vectors
PINECONE_NAMESPACE=customer-support-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional retrieval tuning values.
MIN_RELEVANCE=0.35
CONFIDENCE_THRESHOLD=0.60
RAG_INDEX_BATCH_DELAY_SECONDS=8
