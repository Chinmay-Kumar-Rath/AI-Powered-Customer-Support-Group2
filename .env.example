# Copy this file to .env and replace the placeholders with real credentials.
# Never commit .env or real API keys.

GEMINI_API_KEY=your-gemini-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=customer-support-kb-rag-vectors
PINECONE_NAMESPACE=customer-support-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional retrieval tuning values.
MIN_RELEVANCE=0.35
CONFIDENCE_THRESHOLD=0.60
RAG_INDEX_BATCH_DELAY_SECONDS=8

# ------------------------------------------------------------------ Role C: Jira, email, intake
# Every block works without these: no credentials = mock (Jira) or dry-run (email) mode.

# Jira Cloud (free site + API token from id.atlassian.com > Security > API tokens)
JIRA_MODE=                 # live | mock   (empty = live when the three values below are set)
JIRA_BASE_URL=             # https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP
JIRA_ISSUE_TYPE=Task

# Outbound email via Gmail SMTP. Use a dedicated Google App Password (2-Step Verification must be on).
EMAIL_MODE=dry_run         # dry_run (logged, never sent) | smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=             # the 16-character App Password, never the account password
EMAIL_FROM=

# Inbound email: IMAP poller creates a ticket (source=email) for every unread message
IMAP_ENABLED=false
IMAP_MODE=                 # live | mock (empty = live when IMAP_USER and IMAP_PASSWORD are set)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60

# Webhook intake: POST /intake/webhook with the header  X-API-Key: <WEBHOOK_API_KEY>
WEBHOOK_API_KEY=
# Base URL the "Did this fix it?" links in emails point to
PUBLIC_API_URL=http://localhost:8000
